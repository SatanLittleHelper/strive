{
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": ["type:app", "platform:node"],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/prisma/schema/**",
        "{projectRoot}/prisma.config.ts",
        { "externalDependencies": ["prisma", "@prisma/client"] }
      ],
      "outputs": ["{projectRoot}/src/generated"],
      "options": { "command": "npm run db:generate" }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": {
        "command": "tsc -p apps/api/tsconfig.app.json"
      },
      "dependsOn": ["^build", "generate"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx watch --tsconfig apps/api/tsconfig.app.json apps/api/src/main.ts"
      },
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/api/vitest.config.ts"
      },
      "dependsOn": ["^build", "generate"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/api/tsconfig.app.json --noEmit && tsc -p apps/api/tsconfig.spec.json --noEmit"
      },
      "dependsOn": ["^build", "generate"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/api"
      }
    }
  },
  "implicitDependencies": ["api-interfaces"]
}
