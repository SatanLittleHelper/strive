model set_result {
  session_id   BigInt
  exercise_id  BigInt
  set_number   Int
  weight       Decimal         @db.Decimal(6, 2)
  reps         Int
  rpe          Int?
  note         String?
  completed_at DateTime        @default(now()) @db.Timestamptz(6)
  updated_at   DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  session      workout_session @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@id([session_id, exercise_id, set_number])
}
