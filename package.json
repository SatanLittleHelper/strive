{
  "name": "strive",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "start": "nx run-many -t serve -p web api --parallel=2",
    "start:web": "nx run web:serve",
    "start:api": "nx run api:serve",
    "build": "nx run-many -t build -p web api",
    "typecheck": "nx run-many -t typecheck -p web api web-e2e",
    "lint": "nx run-many -t lint -p web api web-e2e",
    "test": "nx run-many -t test -p web api",
    "test:ci": "npm test",
    "test:coverage": "nx run api:test --coverage && nx run web:test --coverage",
    "e2e": "nx run web-e2e:e2e",
    "format": "prettier --write apps nx.json package.json tsconfig*.json eslint.config.mjs README.md .github/workflows/ci.yml",
    "format:check": "prettier --check apps nx.json package.json tsconfig*.json eslint.config.mjs README.md .github/workflows/ci.yml",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "joi": "18.3.1",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "10.0.1",
    "@nx/angular": "24.0.2",
    "@nx/eslint": "24.0.2",
    "@nx/eslint-plugin": "24.0.2",
    "@nx/js": "24.0.2",
    "@nx/playwright": "24.0.2",
    "@playwright/test": "1.64.1",
    "@swc/core": "1.16.20",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "nx": "24.0.2",
    "pino-pretty": "13.2.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "type": "module",
  "lint-staged": {
    "*.{ts,mts,js,mjs,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml}": [
      "prettier --write"
    ]
  }
}
