# PORT и HOST не включать в .env: Nx передаёт PORT Angular dev-серверу, и он занимает порт API.
# Значения по умолчанию: PORT=3000, HOST=127.0.0.1. Для Docker они заданы в compose.yml.
LOG_LEVEL=info
LOG_PRETTY=true
# POSTGRES_HOST и POSTGRES_PORT задают, где compose публикует Postgres на хосте (по умолчанию 127.0.0.1:5432).
# При смене порта (например, для второго worktree) подставьте тот же порт в DATABASE_URL.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://strive:strive@127.0.0.1:5432/strive
# POSTGRES_PASSWORD подставляется в DATABASE_URL без кодирования: используйте URL-безопасный пароль
POSTGRES_PASSWORD=strive
